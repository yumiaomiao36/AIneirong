[Unit]
Description=Agent Workflow noVNC Web Console
After=agent-workflow-vnc.service
Requires=agent-workflow-vnc.service

[Service]
Type=simple
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 0.0.0.0:6080 127.0.0.1:5900
Restart=always
RestartSec=3
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
